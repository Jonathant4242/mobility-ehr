<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
    <link rel="stylesheet" href="/css/admin-intake.css" />
  </head>
  <body class="admin-dashboard intake-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <%- include('../partials/header', {page: 'intake'}) %>

    <main id="main-content" class="page-width">
      <div class="page-heading">
        <div>
          <p class="eyebrow">Clinic administration</p>
          <h1>Send Patient Paperwork</h1>
          <p class="intro">
            Prepare a paperwork invitation for a patient with an existing account.
            The patient will sign in before completing their intake.
          </p>
        </div>
        <a class="secondary-link" href="/admin">Back to dashboard</a>
      </div>

      <aside class="preview-notice" aria-label="Prototype notice">
        <strong>Parked idea</strong>
        <span>
          Email invitations are outside the current project scope. Patients will
          open their intake after signing in. This draft does not send or save anything.
        </span>
      </aside>

      <p class="panel-note">
        <a href="/intake/preview">Preview patient intake form</a>
        to review the packet the patient will complete.
      </p>

      <div class="intake-layout">
        <%# The server must resolve the recipient from the selected patient before sending. %>
        <form
          id="intake-form"
          class="intake-form"
          action="/admin/intake"
          method="post"
          autocomplete="off"
          aria-describedby="send-note"
        >
          <p class="required-note">
            Fields marked <span aria-hidden="true">*</span> are required.
          </p>

          <fieldset class="form-section">
            <legend>Select a patient</legend>
            <p class="section-intro">
              Send paperwork to a patient with an existing account.
            </p>
            <div class="form-field">
              <label for="patient-account">
                Patient <span aria-hidden="true">*</span>
              </label>
              <select
                id="patient-account"
                name="patientId"
                required
                disabled
                aria-describedby="patient-hint"
              >
                <option value="">Choose a patient</option>
              </select>
              <p id="patient-hint" class="field-hint">
                Patient accounts will appear here when records are connected.
                Need a new account? <a href="/admin/users/new">Add account</a>.
              </p>
            </div>
          </fieldset>

          <fieldset class="form-section">
            <legend>Contact details</legend>
            <p class="section-intro">
              Check the recorded email before sending. Phone is shown when available.
            </p>
            <dl class="contact-details">
              <div>
                <dt>Email</dt>
                <dd>No patient selected</dd>
              </div>
              <div>
                <dt>Phone</dt>
                <dd>No patient selected</dd>
              </div>
            </dl>
          </fieldset>

          <div class="form-actions">
            <button
              id="send-intake"
              class="primary-link"
              type="submit"
              disabled
            >
              Send paperwork invitation
            </button>
            <a class="secondary-link" href="/admin">Cancel</a>
          </div>
          <p id="send-note" class="field-hint">
            Nothing is sent or saved in this preview.
          </p>
        </form>

        <aside class="workflow-panel" aria-labelledby="workflow-heading">
          <p class="eyebrow">Future invitation idea</p>
          <h2 id="workflow-heading">Patient paperwork</h2>
          <ol class="workflow-list">
            <li>
              <strong>Select the patient</strong>
              <span>Choose an existing patient account and check the recorded email.</span>
            </li>
            <li>
              <strong>Send the invitation</strong>
              <span>The patient receives a link to sign in and complete their paperwork.</span>
            </li>
            <li>
              <strong>Sign in</strong>
              <span>The patient uses their existing email and password.</span>
            </li>
            <li>
              <strong>Complete the paperwork</strong>
              <span>The submitted packet is linked to the patient’s profile for admin review.</span>
            </li>
          </ol>
          <p class="workflow-note">
            Paperwork invitations do not create accounts or set passwords.
            The invitation will open the sign-in page; after login, the patient
            can access only their own paperwork. Email delivery is parked for future consideration.
          </p>
        </aside>
      </div>
    </main>

    <%- include('../partials/footer', {page: 'intake'}) %>
  </body>
</html>
