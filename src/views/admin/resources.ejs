<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
  </head>
  <body class="admin-dashboard resources-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <%- include('../partials/header', {page: 'resources'}) %>

    <main id="main-content" class="page-width">
      <div class="page-heading">
        <div>
          <p class="eyebrow">Clinic administration</p>
          <h1>Patient Education Resources</h1>
          <p class="intro">
            Manage the education resources available to patients.
          </p>
        </div>
        <a class="primary-link" href="/admin/resources/new"
          >Add resource <span aria-hidden="true">+</span></a
        >
      </div>

      <aside class="preview-notice" aria-label="Prototype notice">
        <strong>Layout preview</strong>
        <span
          >Review the layout and fields. Records and actions will be added
          later.</span
        >
      </aside>

      <section class="dashboard-section panel" aria-labelledby="library-heading">
        <div class="panel-heading">
          <h2 id="library-heading">Resource library</h2>
          <p>Keep work in progress as a draft. Published resources are available to patients.</p>
        </div>

        <div
          class="table-container"
          role="region"
          aria-label="Resource library table"
          tabindex="0"
        >
          <table>
            <caption class="visually-hidden">Planned resource library columns</caption>
            <thead>
              <tr>
                <th scope="col">Title</th>
                <th scope="col">Category</th>
                <th scope="col">Publication status</th>
                <th scope="col">Last updated</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="5" class="empty-state">
                  <h3>No resource records connected</h3>
                  <p>
                    Resources and their edit links will appear here when records
                    are connected. Use Add resource to review the blank form.
                  </p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="panel-note">
          <a href="/admin/resources/edit-preview">Preview edit resource</a>
          to review the edit and delete controls. Saving and deleting are
          unavailable in this preview.
        </p>
      </section>
    </main>

    <%- include('../partials/footer', {page: 'resources'}) %>
  </body>
</html>
