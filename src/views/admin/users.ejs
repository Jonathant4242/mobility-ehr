<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
    <link rel="stylesheet" href="/css/admin-users.css" />
  </head>
  <body class="admin-dashboard users-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <%- include('../partials/header', {page: 'users'}) %>

    <main id="main-content" class="page-width">
      <div class="page-heading">
        <div>
          <p class="eyebrow">Clinic administration</p>
          <h1>User Accounts and Roles</h1>
          <p class="intro">
            Manage Clinic Admin, Physical Therapist, and Patient accounts.
          </p>
        </div>
        <div class="page-actions">
          <a class="primary-link" href="/admin/users/new">Add account</a>
          <a class="secondary-link" href="/admin">Back to dashboard</a>
        </div>
      </div>

      <aside class="preview-notice" aria-label="Prototype notice">
        <strong>Layout preview</strong>
        <span
          >Review the layout and fields. Records and actions will be added
          later.</span
        >
      </aside>

      <section
        class="dashboard-section panel"
        aria-labelledby="accounts-heading"
      >
        <div class="panel-heading">
          <h2 id="accounts-heading">Account directory</h2>
          <p>
            View account details, roles, and access status. Account status is
            separate from the patient’s care status.
          </p>
        </div>

        <div
          class="table-container"
          role="region"
          aria-label="Account directory table"
          tabindex="0"
        >
          <table>
            <caption class="visually-hidden">
              Planned account directory columns
            </caption>
            <thead>
              <tr>
                <th scope="col">Account</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Account status</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="5" class="empty-state">
                  <h3>No account records connected</h3>
                  <p>
                    Accounts and their edit links will appear here when records are
                    connected. Use Add account to review the blank form.
                  </p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="panel-note">
          <a href="/admin/users/edit-preview">Preview edit account</a> to review
          the fields for changing account details, roles, and access status.
          Saving remains disabled.
        </p>
      </section>
    </main>

    <%- include('../partials/footer', {page: 'users'}) %>
  </body>
</html>
