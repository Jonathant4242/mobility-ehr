<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
  </head>
  <body class="admin-dashboard">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <%- include('../partials/header', {page: 'dashboard'}) %>

    <main id="main-content" class="page-width">
      <div class="page-heading">
        <div>
          <p class="eyebrow">Clinic administration</p>
          <h1>Admin Dashboard</h1>
          <p class="intro">
            Manage intake requests, user roles, and patient education resources.
          </p>
        </div>
        <a class="primary-link" href="/admin/intake/review">Preview intake review</a>
      </div>

      <aside class="preview-notice" aria-label="Prototype notice">
        <strong>Layout preview</strong>
        <span
          >Review the layout and fields. Records and actions will be added
          later.</span
        >
      </aside>

      <section
        id="intake-requests"
        class="dashboard-section panel"
        aria-labelledby="intake-heading"
      >
        <div class="panel-heading">
          <h2 id="intake-heading">Intake Requests</h2>
          <p>
            Review patient paperwork, respond with an administrative note, and
            assign the initial evaluation.
          </p>
        </div>

        <div
          class="table-container"
          role="region"
          aria-label="Intake request list"
          tabindex="0"
        >
          <table>
            <caption class="visually-hidden">
              Planned intake request columns
            </caption>
            <thead>
              <tr>
                <th scope="col">Patient</th>
                <th scope="col">Paperwork received</th>
                <th scope="col">Evaluating therapist</th>
                <th scope="col">Care status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="4" class="empty-state">
                  <h3>Intake list layout</h3>
                  <p>
                    Intake requests will appear here after records are
                    connected.
                  </p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="panel-note">
          Patients will submit their paperwork after signing in.
          <a href="/intake/preview">Preview the blank patient intake form</a>.
        </p>
      </section>

      <div class="dashboard-section management-grid">
        <section class="management-card" aria-labelledby="users-heading">
          <h2 id="users-heading"><a href="/admin/users">Users</a></h2>
          <p>View accounts and manage roles.</p>
        </section>
        <section class="management-card" aria-labelledby="resources-heading">
          <h2 id="resources-heading"><a href="/admin/resources">Education resources</a></h2>
          <p>Add, edit, and delete content in the patient education library.</p>
        </section>
      </div>
    </main>

    <%- include('../partials/footer', {page: 'dashboard'}) %>
  </body>
</html>
