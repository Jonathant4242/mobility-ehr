{
  "name": "mobility-ehr",
  "version": "1.0.0",
  "description": "Mobility EHR is my final project for CSE 340. I chose Option A and am building an electronic health record prototype for a physical therapy clinic. The goal is to help staff manage intake requests and keep patient charts, therapist notes, and treatment plans organized throughout each care episode.",
  "main": "src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:views": "node scripts/check-views.js",
    "check": "npm run lint && npm run format:check && npm run check:views"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonathant4242/mobility-ehr.git"
  },
  "keywords": [],
