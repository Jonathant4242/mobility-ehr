  "type": "module",
  "bugs": {
    "url": "https://github.com/Jonathant4242/mobility-ehr/issues"
  },
  "homepage": "https://github.com/Jonathant4242/mobility-ehr#readme",
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
